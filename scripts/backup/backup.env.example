# Cấu hình backup — copy file này thành `backup.env` TRÊN SERVER rồi điền giá trị thật.
#   cp backup.env.example backup.env && chmod 600 backup.env
# `backup.env` chứa mật khẩu DB nên đã được .gitignore — KHÔNG commit.

# --- MySQL (app riêng trên CapRover) ---
# Tên app MySQL trong CapRover (KHÔNG có tiền tố srv-captain--).
# Xem bằng: docker ps --format '{{.Names}}' | grep srv-captain--
MYSQL_APP_NAME=mysql
MYSQL_DATABASE=erp
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Thư mục ảnh trên host (Persistent Directory đã mount vào container) ---
UPLOADS_DIR=/captain/data/erp-uploads

# Chặn xoá hàng loạt: nếu một lần sync định xoá nhiều hơn số này trên R2 thì rclone huỷ
# toàn bộ thao tác, không xoá gì cả. Bảo vệ khi mount lỗi hoặc ai đó xoá nhầm.
# Chạy một lần với số cao hơn nếu bạn CHỦ Ý dọn nhiều ảnh:  MAX_DELETE=500 ./backup-uploads.sh
MAX_DELETE=50

# --- Cloudflare R2 (qua rclone) ---
# Tên remote đã cấu hình bằng `rclone config` (xem README).
RCLONE_REMOTE=r2
# Bucket dùng riêng cho backup — nên tách khỏi bucket chứa file app.
R2_BUCKET=erp-backup

# --- Tuỳ chọn: giữ thêm 1 bản dump DB trên host ---
# Để trống nếu chỉ muốn đẩy lên R2. Nếu set, file cũ hơn KEEP_LOCAL_DAYS ngày sẽ bị xoá.
LOCAL_BACKUP_DIR=
KEEP_LOCAL_DAYS=7
